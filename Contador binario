/*Librerias*/
#include <Arduino.h>
#include <stdio.h>
#include <stdint.h>

/*Definiciones*/

#define tiempo 25000

#define B1 35
#define B2 34
//#define B3 27

#define L1 13 //leds manual
#define L2 14
#define L3 26
#define L4 33

#define L5 15 //leds automatico
#define L6 2
#define L7 4
#define L8 16

#define L9 23 //led de alarma

/*Prototipos de funciones*/
void configTimer(void);
void IRAM_ATTR B1_incremento_ISR(); //funciones de interrupciones de boton
void IRAM_ATTR B2_decremento_ISR();

void IRAM_ATTR timerA_ISR(); //funcion de timer

/*Variables globales*/
volatile uint8_t contador = 0; //contadores empiezan en 0
volatile uint8_t contadorAuto = 0;

volatile uint8_t alarma = LOW; //estado de la alarma
uint8_t comparador = 0; //detecta si los contadores coinciden

volatile uint32_t t1 = 0;
volatile uint32_t t2 = 0;

hw_timer_t *timerA = NULL;

const int ledsManual[4]={L1,L2,L3,L4}; 
const int ledsAuto[4]={L5,L6,L7,L8};

const int contadorbinario[16][4]={
{LOW,LOW,LOW,LOW}, //0
{LOW,LOW,LOW,HIGH}, //1
{LOW,LOW,HIGH,LOW}, //2
{LOW,LOW,HIGH,HIGH}, //3
{LOW,HIGH,LOW,LOW}, //4
{LOW,HIGH,LOW,HIGH}, //5
{LOW,HIGH,HIGH,LOW}, //6
{LOW,HIGH,HIGH,HIGH}, //7
{HIGH,LOW,LOW,LOW}, //8
{HIGH,LOW,LOW,HIGH}, //9
{HIGH,LOW,HIGH,LOW}, //10
{HIGH,LOW,HIGH,HIGH}, //11
{HIGH,HIGH,LOW,LOW}, //12
{HIGH,HIGH,LOW,HIGH}, //13
{HIGH,HIGH,HIGH,LOW}, //14
{HIGH,HIGH,HIGH,HIGH}, //15
};


/*ISRs rutinas de interrupcion*/

void IRAM_ATTR B1_incremento_ISR(){
  if((millis()-t1)>100){ //antirrebote que calcula el tiempo que pasó desde la última pulsación
    contador++; //incrementa
    
    if(contador>15){ //limite max
      contador=0;
    }
    t1=millis(); //guarda pulsacion
  }
}

void IRAM_ATTR B2_decremento_ISR(){
  if((millis()-t2)>100){
    contador--; //decrementa

    if(contador<0){ //limite min
      contador=15;
    }
    t2=millis();
  }
}

void IRAM_ATTR timerA_ISR(){
  contadorAuto++; //incrementa el contador de manera automatica

  if(contadorAuto > 15){ //limites del contador circular
    contadorAuto = 0;
  }

}

/*Funcion principal*/
void setup(){

pinMode(B1,INPUT_PULLDOWN);
pinMode(B2,INPUT_PULLDOWN);
//pinMode(B3, INPUT_PULLDOWN);

pinMode(L1,OUTPUT);
pinMode(L2,OUTPUT);
pinMode(L3,OUTPUT);
pinMode(L4,OUTPUT);
pinMode(L5,OUTPUT);
pinMode(L6,OUTPUT);
pinMode(L7,OUTPUT);
pinMode(L8,OUTPUT);
pinMode(L9,OUTPUT);

attachInterrupt(digitalPinToInterrupt(B1), B1_incremento_ISR, RISING);
attachInterrupt(digitalPinToInterrupt(B2), B2_decremento_ISR, RISING);

configTimer();

}

void loop(){

for (int i = 0; i < 4; i++) {
  digitalWrite(ledsManual[i], contadorbinario[contador][i]); 
}

for(int i=0;i<4;i++){
    digitalWrite(ledsAuto[i], contadorbinario[contadorAuto][i]);
}

// comparacion de contadores
if(contador == contadorAuto){

  if(comparador == 0){

    if(alarma == LOW){ //intermitencia del led cuando hay coincidencia
      alarma = HIGH;
    }
    else{
      alarma = LOW;
    }

    digitalWrite(L9, alarma); //actualiza el estado de la alarma

  
    contadorAuto = 0;
    comparador = 1;
  }
}

else{
  comparador = 0;
}

}


void configTimer(void){

  timerA = timerBegin(0, 800, true);
 
  timerAttachInterrupt(timerA, &timerA_ISR, true);
  
  timerAlarmWrite(timerA, tiempo, true);
  
  timerAlarmEnable(timerA);
}
